{
  "version": 1,
  "description": "Maps recognised Speech Commands v2 keywords to editor actions. Single source of truth shared by backend-python/services/command_mapper.py and backend-go/voice/mapper.go. Every one of the 37 classes (35 keywords + silence + unknown) must appear exactly once, either under 'commands' or under 'no_action'. select_tab_N: N is the spoken digit.",
  "confidence_threshold": 0.75,
  "commands": {
    "go": { "action": "execute_active_file" },
    "stop": { "action": "stop_execution" },
    "on": { "action": "toggle_focus_mode", "params": { "direction": "enter" } },
    "off": { "action": "toggle_focus_mode", "params": { "direction": "exit" } },
    "up": { "action": "scroll", "params": { "direction": "up" } },
    "down": { "action": "scroll", "params": { "direction": "down" } },
    "left": { "action": "switch_tab", "params": { "direction": "left" } },
    "right": { "action": "switch_tab", "params": { "direction": "right" } },
    "yes": { "action": "confirm" },
    "no": { "action": "cancel" },
    "forward": { "action": "redo" },
    "backward": { "action": "undo" },
    "learn": { "action": "toggle_task_chunking" },
    "visual": { "action": "toggle_theme" },
    "follow": { "action": "toggle_chat_panel" },
    "zero": { "action": "select_tab_0" },
    "one": { "action": "select_tab_1" },
    "two": { "action": "select_tab_2" },
    "three": { "action": "select_tab_3" },
    "four": { "action": "select_tab_4" },
    "five": { "action": "select_tab_5" },
    "six": { "action": "select_tab_6" },
    "seven": { "action": "select_tab_7" },
    "eight": { "action": "select_tab_8" },
    "nine": { "action": "select_tab_9" }
  },
  "no_action": [
    "bed",
    "bird",
    "cat",
    "dog",
    "happy",
    "house",
    "marvin",
    "sheila",
    "tree",
    "wow",
    "unknown",
    "silence"
  ]
}
